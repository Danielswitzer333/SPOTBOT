{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/claude.js": {"maxDuration": 30},
    "api/market.js": {"maxDuration": 10}
  },
  "rewrites": [
    {"source": "/api/claude", "destination": "/api/claude"},
    {"source": "/api/market", "destination": "/api/market"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
